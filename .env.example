# EmailJS — créez un compte sur https://www.emailjs.com
# 1. Créez un service email (Gmail, Outlook…)
# 2. Créez un template avec les variables : {{to_email}}, {{sender_name}}, {{card_url}}, {{recipient_name}}
# 3. Copiez vos identifiants ci-dessous dans un fichier .env

VITE_EMAILJS_SERVICE_ID= 
VITE_EMAILJS_TEMPLATE_ID= 
VITE_EMAILJS_PUBLIC_KEY= 


# URL de base pour les cartes (remplacez par votre domaine Vercel)
VITE_BASE_URL=
